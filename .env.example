# Gemini API Key (Required for AI data preparation recommendations and Natural Language SQL generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Configuration (Comma-separated allowed origins for production deployment)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
